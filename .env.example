# ──────────────────────────────────────────────────
# SIH NetFlow — Environment Variables
# Copy this to .env and adjust values as needed
# ──────────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://sih:sih@db:5432/sih_netflow
SYNC_DATABASE_URL=postgresql+psycopg2://sih:sih@db:5432/sih_netflow

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# File storage
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=500

# Pipeline defaults
DEFAULT_WINDOW_SECONDS=60
