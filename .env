# Local development mode — uses SQLite, no external services required
# For Docker mode: use the postgresql+asyncpg URLs below (uncomment)
DATABASE_URL=sqlite+aiosqlite:///./sih_netflow.db
SYNC_DATABASE_URL=sqlite:///./sih_netflow.db
REDIS_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500
DEFAULT_WINDOW_SECONDS=60
SEQUENCE_LENGTH=8
FORECAST_STEPS=5
